<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ext.rich_media_notifications">

    <!-- Permissions for loading remote media -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Required for foreground service media notifications (API 28+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
        android:minSdkVersion="34" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- Foreground service for media playback notifications -->
        <service
            android:name=".MediaNotificationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Receiver for notification action buttons (play/pause/next/prev) -->
        <receiver
            android:name=".NotificationActionReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.ext.rich_media_notifications.ACTION_PLAY" />
                <action android:name="com.ext.rich_media_notifications.ACTION_PAUSE" />
                <action android:name="com.ext.rich_media_notifications.ACTION_NEXT" />
                <action android:name="com.ext.rich_media_notifications.ACTION_PREV" />
                <action android:name="com.ext.rich_media_notifications.ACTION_STOP" />
            </intent-filter>
        </receiver>
    </application>

</manifest>